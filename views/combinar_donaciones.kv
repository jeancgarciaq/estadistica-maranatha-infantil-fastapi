<CombinarDonacionesScreen>:
    name: 'combinar_donaciones'
    
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 1. TÍTULO (Fijo arriba)
        Label:
            text: 'Preparación de Alimentos'
            font_size: '22sp'
            size_hint_y: None
            height: dp(60)
            bold: True

        # 2. ÁREA DE CONTENIDO (Con Scroll para que el teclado no estorbe)
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(15)
                spacing: dp(20)

                # --- SECCIÓN: ALIMENTO PREPARADO ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(15)

                    Label:
                        text: 'ALIMENTO PREPARADO'
                        font_size: '18sp'
                        bold: True
                        size_hint_y: None
                        height: dp(30)
                        halign: 'left'
                        text_size: self.size

                    # Campo: Descripción
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(70)
                        Label:
                            text: 'Descripción:'
                            font_size: '16sp'
                            halign: 'left'
                            text_size: self.size
                        TextInput:
                            id: res_descripcion
                            multiline: False
                            hint_text: 'Ej: Jugo de papelón'
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                    # Fila: Cantidad y Medida (Ahorro de espacio)
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(130)
                        spacing: dp(10)
                        
                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: 'Cantidad:'
                                font_size: '16sp'
                                halign: 'left'
                                text_size: self.size
                            TextInput:
                                id: res_cantidad
                                multiline: False
                                input_filter: 'float'
                                font_size: '18sp'
                                size_hint_y: None
                                height: dp(40)

                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: 'Medida:'
                                font_size: '16sp'
                                halign: 'left'
                                text_size: self.size
                            Spinner:
                                id: res_unidad
                                text: 'Unidad(es)'
                                values: root.medidas
                                font_size: '18sp'
                                size_hint_y: None
                                height: dp(40)

                    # Fila: Fecha y Equipo
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(130)
                        spacing: dp(10)

                        # Sub-bloque Fecha
                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: 'Fecha:'
                                font_size: '16sp'
                                halign: 'left'
                                text_size: self.size
                            BoxLayout:
                                orientation: 'horizontal'
                                size_hint_x: None
                                width: dp(200)
                                TextInput:
                                    id: res_fecha
                                    readonly: True
                                    font_size: '16sp'
                                    multiline: False
                                Button:
                                    text: '\uf133'  
                                    font_name: 'LineAwesome' 
                                    font_size: '24sp'
                                    background_normal: ''
                                    background_color: (0, 0.47, 0.76, 1)
                                    on_press: root.abrir_datepicker('res_fecha')

                        # Sub-bloque Equipo
                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: 'Equipo:'
                                font_size: '16sp'
                                halign: 'left'
                                text_size: self.size
                            TextInput:
                                id: res_equipo
                                multiline: False
                                font_size: '18sp'
                                size_hint_y: None
                                height: dp(40)

                # Separador visual
                Widget:
                    size_hint_y: None
                    height: dp(10)

                # --- SECCIÓN: MATERIAS PRIMAS ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: dp(50)
                        spacing: dp(10)
                        Label:
                            text: 'MATERIAS PRIMAS'
                            font_size: '18sp'
                            bold: True
                            halign: 'left'
                            text_size: self.size
                        Button:
                            text: '+ Agregar'
                            size_hint_x: None
                            width: dp(120)
                            font_size: '16sp'
                            background_normal: ''
                            background_color: (0, 0.6, 0.3, 1)
                            on_press: root.abrir_popup_materias_primas()

                    # Contenedor dinámico de componentes
                    BoxLayout:
                        id: lista_componentes
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(5)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 0.05
                            Rectangle:
                                pos: self.pos
                                size: self.size

                    Label:
                        text: '* Se registra el uso sin descontar la donación original.'
                        italic: True
                        font_size: '13sp'
                        color: 0.8, 0.8, 0.8, 1
                        size_hint_y: None
                        height: dp(30)

        # 3. FOOTER DE ACCIONES (Fijo abajo)
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(130)
            padding: dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.2
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Botón principal grande
            Button:
                text: 'REGISTRAR PREPARADO'
                font_size: '18sp'
                bold: True
                background_normal: ''
                background_color: (0, 0.47, 0.76, 1)
                size_hint_y: 0.5
                on_press: root.realizar_combinacion()

            # Botones secundarios en fila
            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_y: 0.5

                Button:
                    text: 'LISTAR'
                    font_size: '16sp'
                    background_normal: ''
                    background_color: (0.2, 0.5, 0.2, 1)
                    on_press: root.ver_lista_preparados()

                Button:
                    text: 'VOLVER'
                    font_size: '16sp'
                    background_normal: ''
                    background_color: (0.5, 0.5, 0.5, 1)
                    on_press: root.manager.current = 'menu'