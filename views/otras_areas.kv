<OtrasAreasScreen>:
    name: 'otrasareas'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Otras Áreas de Maranatha Infantil'
            font_size: '24sp'
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(60)

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(12)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Alabanza:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_alabanza
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Protocolo:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_protocolo
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Semillitas:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_semillitas
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Sonido:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_sonido
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Teatro:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_teatro
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'TV:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_tv
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Ujier:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_ujier
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Seguridad:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_seguridad
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Fecha:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: otrasareas_fecha
                            readonly: True
                            hint_text: 'YYYY-MM-DD'
                            multiline: False
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)
                        Button:
                            size_hint_x: None
                            width: dp(50)
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_datepicker('otrasareas_fecha')
                            Image:
                                source: 'images/calendar_icon.png'
                                center_x: self.parent.center_x
                                center_y: self.parent.center_y
                                size: dp(30), dp(30)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'ID Otras Áreas:'
                        font_size: '18sp'
                        halign: 'left'
                        text_size: self.size
                        color: 1, 1, 1, 1
                    TextInput:
                        id: otrasareas_id
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(180)
            padding: dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.2
                Rectangle:
                    pos: self.pos
                    size: self.size

            GridLayout:
                cols: 2
                spacing: dp(10)
                size_hint_y: 0.75

                Button:
                    text: 'Crear'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0, 0.47, 0.76, 1)
                    on_press: root.crear_otrasareas()

                Button:
                    text: 'Actualizar'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0, 0.47, 0.76, 1)
                    on_press: root.actualizar_otrasareas()

                Button:
                    text: 'Listar'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0.2, 0.6, 0.2, 1)
                    on_press: app.root.current = 'lista_otras_areas'

                Button:
                    text: 'Limpiar'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0.5, 0.5, 0.5, 1)
                    on_press: root._limpiar_campos()

            Button:
                text: 'Volver al Menú'
                size_hint_y: 0.25
                font_size: '18sp'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: root.manager.current = 'menu'
