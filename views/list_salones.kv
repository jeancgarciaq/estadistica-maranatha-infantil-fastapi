<SalonCard@BoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(15)
    spacing: dp(5)

    salon_id: ''
    nombre: ''
    edad: ''

    canvas.before:
        Color:
            rgba: 0.18, 0.28, 0.48, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10),]

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(30)
        Label:
            text: 'ID: ' + str(root.salon_id)
            bold: True
            font_size: '14sp'
            halign: 'left'
            text_size: self.size
            color: 0.8, 0.8, 0.8, 1

    Label:
        text: 'Salón: ' + root.nombre
        bold: True
        font_size: '18sp'
        halign: 'left'
        valign: 'middle'
        text_size: (self.width, None)
        size_hint_y: None
        height: self.texture_size[1]
        color: 1, 1, 1, 1

    Label:
        text: 'Edad: ' + root.edad
        font_size: '16sp'
        halign: 'left'
        valign: 'middle'
        text_size: (self.width, None)
        size_hint_y: None
        height: self.texture_size[1]
        color: 0.9, 0.9, 0.9, 1


<ListSalonesScreen>:
    name: 'lista_salones'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Lista de Salones'
            font_size: '22sp'
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(60)
        ScrollView:
            do_scroll_x: False
            GridLayout:
                id: lista_salones
                cols: 1 # Optimizado para móvil: una columna
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
                padding: dp(15)

        #Contenedor de botones
        BoxLayout:
            orientation: 'vertical'
            spacing: dp(10)
            padding: dp(10)
            size_hint_y: None
            height: self.minimum_height
            GridLayout:
                cols: 2
                spacing: dp(10)
                size_hint_y: None
                height: dp(70)
                
                Button:
                    text: 'LISTAR'
                    font_size: '18sp'
                    bold: True
                    background_normal: ''
                    background_color: (0, 0.6, 0.2, 1)
                    on_press: root.controlador.listar_salones(root)
                Button:
                    text: 'VOLVER'
                    font_size: '18sp'
                    bold: True
                    background_normal: ''
                    background_color: (0.5, 0.5, 0.5, 1)
                    on_press: root.manager.current = 'salones'