<ListAulasScreen>:
    name: 'lista_aulas'

    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: 'Lista de Aulas'
            font_size: '22sp'
            size_hint_y: None
            height: dp(60)
            bold: True

        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(80)
            padding: dp(10)
            spacing: dp(10)

            BoxLayout:
                orientation: 'vertical'

                Label:
                    text: 'Fecha:'
                    font_size: '16sp'
                    halign: 'left'
                    text_size: self.size

                BoxLayout:
                    orientation: 'horizontal'
                    spacing: dp(10)

                    TextInput:
                        id: fecha_filtro
                        readonly: True
                        hint_text: 'YYYY-MM-DD'
                        multiline: False
                        font_size: '16sp'

                    Button:
                        text: '\uf133'
                        font_name: 'LineAwesome'
                        font_size: '24sp'
                        size_hint_x: None
                        width: dp(50)
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press: root.abrir_datepicker('fecha_filtro')

            Button:
                text: 'Limpiar'
                size_hint_x: None
                width: dp(90)
                font_size: '16sp'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: root.limpiar_filtro_fecha()

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            GridLayout:
                id: lista_aulas
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(10)
                padding: dp(10)

        GridLayout:
            cols: 2
            size_hint_y: None
            height: dp(120)
            padding: dp(10)
            spacing: dp(10)

            Button:
                text: 'LISTAR'
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0, 0.47, 0.76, 1)
                on_press: root.cargar_aulas()

            Button:
                text: 'CERRAR'
                font_size: '16sp'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: app.root.current = 'aulas'


<AulaCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(190)
    padding: dp(10)
    spacing: dp(6)

    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

    Label:
        text: '[b]' + root.titulo + '[/b]'
        markup: True
        font_size: '18sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: dp(30)

    Label:
        text: root.info
        font_size: '13sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: dp(90)

    BoxLayout:
        size_hint_y: None
        height: dp(38)
        spacing: dp(8)

        Button:
            text: 'Editar'
            font_size: '13sp'
            background_normal: ''
            background_color: (0, 0.5, 1, 1)
            on_press: root.editar_callback(root.aula_id) if root.editar_callback else None

        Button:
            text: 'Eliminar'
            font_size: '13sp'
            background_normal: ''
            background_color: (1, 0.2, 0.2, 1)
            on_press: root.eliminar_callback(root.aula_id) if root.eliminar_callback else None
