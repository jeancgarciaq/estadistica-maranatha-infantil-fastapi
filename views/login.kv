#:import dp kivy.metrics.dp

<LoginScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(24)
        spacing: dp(16)
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Widget:
            size_hint_y: 0.2

        Label:
            text: 'Maranatha Kids'
            font_size: '34sp'
            bold: True
            size_hint_y: None
            height: dp(56)

        Label:
            text: 'Iniciar sesion'
            font_size: '22sp'
            size_hint_y: None
            height: dp(44)

        TextInput:
            id: login_username
            hint_text: 'Usuario'
            multiline: False
            font_size: '18sp'
            size_hint_y: None
            height: dp(46)

        TextInput:
            id: login_password
            hint_text: 'Contrasena'
            password: True
            multiline: False
            font_size: '18sp'
            size_hint_y: None
            height: dp(46)
            on_text_validate: root.iniciar_sesion()

        Button:
            text: 'Ingresar'
            font_size: '18sp'
            bold: True
            size_hint_y: None
            height: dp(48)
            background_normal: ''
            background_color: (0, 0.47, 0.76, 1)
            on_press: root.iniciar_sesion()

        Button:
            text: 'Limpiar'
            font_size: '16sp'
            size_hint_y: None
            height: dp(44)
            background_normal: ''
            background_color: (0.5, 0.5, 0.5, 1)
            on_press: root.limpiar()

        Widget:
            size_hint_y: 0.3
