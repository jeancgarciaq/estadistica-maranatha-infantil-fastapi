<LogisticaScreen>:
    name: 'logisticas'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Logistica de Maranatha Infantil'
            font_size: 30
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 50
        # Formulario
        ScrollView:
            size_hint_y: 1
            GridLayout:
                cols: 2
                padding: 20
                spacing: 20
                size_hint_y: None
                height: self.minimum_height
                row_default_height: 50
                Label:
                    text: 'Almacén:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_almacen
                Label:
                    text: 'Capitán:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_capitan
                Label:
                    text: 'Distribución:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_distribucion
                Label:
                    text: 'Hidratación:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_hidratacion
                Label:
                    text: 'Pasillo:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_pasillo
                Label:
                    text: 'Secretaría:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_secretaria
                Label:
                    text: 'Fecha (YYYY-MM-DD):'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                BoxLayout:
                    orientation: 'horizontal'
                    spacing: 10
                    TextInput:
                        id: logistica_fecha
                        readonly: True
                        hint_text: 'YYYY-MM-DD'
                    Button:
                        size_hint_x: None
                        width: 50
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.abrir_datepicker('logistica_fecha')
                        Image:
                            source: 'images/calendar_icon.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: 30, 30
                            allow_stretch: True
                Label:
                    text: 'ID Logistica:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                TextInput:
                    id: logistica_id
                # Lista de logísticas
                Label:
                    text: 'Lista de Logistica:'
                    font_size: 20
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 30
                ScrollView:
                    GridLayout:
                        id: lista_logisticas
                        cols: 3 # Nombre, Editar, Eliminar
                        size_hint_y: None
                        height: self.minimum_height
        #Contenedor de botones 
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            padding: 10
            Button:
                text: 'Crear'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                size_hint_y: None
                height: 50
                on_press: root.crear_logistica()
            Button:
                text: 'Actualizar'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                size_hint_y: None
                height: 50
                on_press: root.actualizar_logistica()
            Button:
                text: 'Eliminar'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                size_hint_y: None
                height: 50
                on_press: root.eliminar_logistica(logistica_id.text)
            Button:
                text: 'Listar'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                size_hint_y: None
                height: 50
                on_press: root.cargar_logisticas()
        Button:
            text: 'Volver al Menú'
            font_size: 28
            background_normal: ''
            background_color: (0, 119/255, 194/255, 1)
            size_hint_y: None
            height: 50
            on_press: root.manager.current = 'menu'
