#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<AyudaScreen>:
    name: 'ayuda'
    BoxLayout:
        orientation: 'vertical'
        padding: dp(14)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        BoxLayout:
            size_hint_y: None
            height: dp(132)
            spacing: dp(12)
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.06, 0.11, 0.24, 0.95
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]
            Image:
                source: 'images/ayuda.png'
                size_hint_x: None
                width: dp(96)
                fit_mode: 'contain'
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(4)
                Label:
                    text: 'Ayuda de Maranatha Infantil'
                    font_size: sp(24)
                    bold: True
                    color: 1, 1, 1, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    text: 'Guía rápida para entender cada parte de la aplicación y entrar al módulo que necesitas.'
                    font_size: sp(15)
                    color: 0.88, 0.92, 1, 1
                    halign: 'left'
                    valign: 'top'
                    text_size: self.size
        ScrollView:
            do_scroll_x: False
            bar_width: dp(8)
            GridLayout:
                cols: 1
                spacing: dp(14)
                padding: dp(2), dp(2)
                size_hint_y: None
                height: self.minimum_height

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 0.08, 0.15, 0.31, 0.96
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18]
                    Label:
                        text: 'Inicio rápido'
                        font_size: sp(20)
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(10)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None
                    Label:
                        text: '1. Entra al menú principal.\n2. Abre el módulo que corresponda a tu trabajo.\n3. Registra la información y vuelve al menú cuando termines.\n4. Si no ves una pantalla, puede depender de tus permisos.'
                        font_size: sp(15)
                        color: 0.9, 0.95, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(12)
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(10)
                    canvas.before:
                        Color:
                            rgba: 0.07, 0.13, 0.27, 0.96
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18]
                    Label:
                        text: 'Qué hace cada sección'
                        font_size: sp(20)
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(10)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None
                    Label:
                        text: 'Áreas, salones y aulas organizan la estructura del servicio. Donaciones y preparaciones registran la merienda recibida y preparada. Distribuciones, logística, recepción y otras áreas ayudan a controlar la entrega y el movimiento interno. Estadística y reporte concentran los totales para revisión y salida de información. Usuarios administra permisos y accesos.'
                        font_size: sp(15)
                        color: 0.9, 0.95, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(12)
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None

                    GridLayout:
                        cols: 2
                        spacing: dp(8)
                        size_hint_y: None
                        height: self.minimum_height

                        Button:
                            text: 'Áreas'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('areas')
                        Button:
                            text: 'Salones'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_salones()
                        Button:
                            text: 'Aulas'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_aulas()
                        Button:
                            text: 'Donaciones'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('donaciones')
                        Button:
                            text: 'Preparados'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('combinar_donaciones')
                        Button:
                            text: 'Distribuciones'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('distribuciones')
                        Button:
                            text: 'Logística'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('logisticas')
                        Button:
                            text: 'Otras áreas'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('otrasareas')
                        Button:
                            text: 'Enseñanza'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('ensenanza')
                        Button:
                            text: 'Recepción'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('recepcion')
                        Button:
                            text: 'Estadística'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('estadistica')
                        Button:
                            text: 'Reporte'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('reporte')
                        Button:
                            text: 'Usuarios'
                            size_hint_y: None
                            height: dp(48)
                            background_normal: ''
                            background_color: 0.0, 0.46, 0.76, 1
                            on_release: root.ir_a('usuarios')

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16)
                    spacing: dp(8)
                    canvas.before:
                        Color:
                            rgba: 0.06, 0.11, 0.24, 0.96
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [18]
                    Label:
                        text: 'Tutoriales en YouTube'
                        font_size: sp(20)
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(10)
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.width, None
                    Label:
                        text: 'En una próxima etapa esta pantalla incluirá tutoriales en video para cada módulo. La idea es que esta ayuda quede como una guía escrita rápida, y que los videos expliquen el uso paso a paso con ejemplos reales.'
                        font_size: sp(15)
                        color: 0.9, 0.95, 1, 1
                        size_hint_y: None
                        height: self.texture_size[1] + dp(12)
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width, None
                    Button:
                        text: 'Ver aviso de tutoriales'
                        size_hint_y: None
                        height: dp(48)
                        background_normal: ''
                        background_color: 0.16, 0.62, 0.95, 1
                        on_release: root.mostrar_tutoriales()

        BoxLayout:
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)
            Button:
                text: 'Volver al menú'
                font_size: sp(16)
                background_normal: ''
                background_color: 0.0, 0.46, 0.76, 1
                on_release: root.manager.current = 'menu'
