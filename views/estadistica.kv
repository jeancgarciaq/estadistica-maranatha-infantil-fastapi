<EstadisticaScreen>:
    name: 'estadistica'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Estadísticas'
            font_size: 34
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 60
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 50
            padding: 10
            spacing: 10
            TextInput:
                id: fecha_reporte
                hint_text: 'YYYY-MM-DD'
                readonly: True
            Button:
                text: 'Fecha'
                size_hint_x: None
                width: 120
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: root.abrir_datepicker('fecha_reporte')
        ScrollView:
            Label:
                text: root.resumen_texto
                color: 1, 1, 1, 1
                font_size: 20
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] + 20
        Label:
            text: root.pdf_texto
            color: 1, 1, 1, 1
            font_size: 16
            size_hint_y: None
            height: 30
        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 10
            padding: 10
            Button:
                text: 'Generar Resumen'
                font_size: 22
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: root.generar_resumen()
            Button:
                text: 'Abrir PDF'
                font_size: 22
                background_normal: ''
                background_color: (0.18, 0.5, 0.22, 1)
                on_press: root.abrir_pdf()
            Button:
                text: 'Volver al Menú'
                font_size: 22
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: root.manager.current = 'menu'
