<EstadisticaScreen>:
    name: 'estadistica'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Estadísticas'
            font_size: 34
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 60
        Label:
            text: root.resumen_texto
            color: 0.9, 0.95, 1, 1
            font_size: 14
            size_hint_y: None
            height: 28
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 56
            padding: 10
            spacing: 10
            TextInput:
                id: fecha_reporte
                hint_text: 'YYYY-MM-DD'
                readonly: True
            Button:
                text: 'Fecha'
                size_hint_x: None
                width: 120
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: root.abrir_datepicker('fecha_reporte')
            Button:
                text: 'Consultar Estadística'
                size_hint_x: None
                width: 170
                background_normal: ''
                background_color: (0.18, 0.5, 0.22, 1)
                on_press: root.actualizar_vista()
        ScrollView:
            GridLayout:
                id: informe_container
                cols: 1
                spacing: 14
                padding: [14, 12, 14, 12]
                size_hint_y: None
                height: self.minimum_height
        BoxLayout:
            size_hint_y: None
            height: 40
            spacing: 10
            padding: 10
            Button:
                text: 'Volver al Menú'
                font_size: 18
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: root.manager.current = 'menu'
