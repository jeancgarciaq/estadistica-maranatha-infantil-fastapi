                        on_press: root.manager.current = "combinar_donaciones"

        # Botón SALIR fijo en la parte inferior (patrón Android estándar)
        Button:
            text: 'SALIR'
            size_hint_y: None
            height: dp(48)
            font_size: sp(16)
            background_normal: ''
            background_color: (180/255, 0, 0, 1)
            on_press: app.stop()