<MenuScreen>:
    # Contenedor principal que asegura fondo completo y layout vertical
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            # Grid de 2 columnas: estándar para menús táctiles en móvil
            GridLayout:
                cols: 2
                row_force_default: True
                row_default_height: dp(120)
                size_hint_y: None
                height: self.minimum_height
                padding: dp(16)
                spacing: dp(12)

                # --- ÍTEM 1: ÁREAS ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/areas.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'ÁREAS'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "areas"

                # --- ÍTEM 2: SALONES ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/salones.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'SALONES'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "salones"

                # --- ÍTEM 3: ESTADÍSTICA ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/aulas.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'ESTADÍSTICA'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "estadistica"

                # --- ÍTEM 4: DONACIONES ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/donacion.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'DONACIONES'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "donaciones"

                # --- ÍTEM 5: DISTRIBUCIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/distribucion.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'DISTRIBUCIÓN'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "distribuciones"

                # --- ÍTEM 6: LOGÍSTICA ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/logistic.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'LOGÍSTICA'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "logistica"

                # --- ÍTEM 7: OTRAS ÁREAS ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/otras.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'OTRAS ÁREAS'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "otrasareas"

                # --- ÍTEM 8: ENSEÑANZA ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/ensenanza.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'ENSEÑANZA'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "ensenanza"

                # --- ÍTEM 9: RECEPCIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/recepcion.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'RECEPCIÓN'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "recepcion"

                # --- ÍTEM 10: REPORTE ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/report.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'REPORTE'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "reporte"

                # --- ÍTEM 11: AYUDA ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
                        source: 'images/ayuda.png'
                        size_hint_y: 0.75
                        allow_stretch: True
                        keep_ratio: True
                    Button:
                        text: 'AYUDA'
                        font_size: sp(15)
                        size_hint_y: 0.25
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.manager.current = "ayuda"

                # --- ÍTEM 12: PREPARADOS ---
                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(4)
                    padding: dp(4)
                    Image:
