<SalonesScreen>:
    name: 'salones'

    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(15)

                Label:
                    text: 'Salones de Maranatha Infantil'
                    font_size: '24sp'
                    size_hint_y: None
                    height: dp(60)
                    bold: True
                    color: 1, 1, 1, 1

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: dp(10)

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(70)
                        Label:
                            text: 'Id salón:'
                            font_size: '18sp'
                            halign: 'left'
                            text_size: self.size
                            color: 1, 1, 1, 1
                        TextInput:
                            id: salon_id
                            multiline: False
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(70)
                        Label:
                            text: 'Salón:'
                            font_size: '18sp'
                            halign: 'left'
                            text_size: self.size
                            color: 1, 1, 1, 1
                        TextInput:
                            id: salon_nombre
                            multiline: False
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(70)
                        Label:
                            text: 'Edad:'
                            font_size: '18sp'
                            halign: 'left'
                            text_size: self.size
                            color: 1, 1, 1, 1
                        TextInput:
                            id: salon_edad
                            multiline: False
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                GridLayout:
                    cols: 2
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(120)

                    Button:
                        text: 'Crear'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press: root.crear_salon()

                    Button:
                        text: 'Actualizar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press: root.actualizar_salon()

                    Button:
                        text: 'Eliminar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0.8, 0.2, 0.2, 1)
                        on_press: root.eliminar_salon(salon_id.text)

                    Button:
                        text: 'Buscar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press:
                            root.buscar_salon()
                            salon_id.text = ''
                            salon_nombre.text = ''

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(160)
            padding: dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.2
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: 'Ver Lista de Salones'
                size_hint_y: 0.45
                font_size: '18sp'
                background_normal: ''
                background_color: (0.2, 0.6, 0.2, 1)
                on_press: root.manager.current = 'lista_salones'

            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_y: 0.55

                Button:
                    text: 'Gestionar Aulas'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0, 0.47, 0.76, 1)
                    on_press: root.manager.current = 'aulas'

                Button:
                    text: 'Volver al Menú'
                    font_size: '18sp'
                    background_normal: ''
                    background_color: (0.5, 0.5, 0.5, 1)
                    on_press: root.manager.current = 'menu'