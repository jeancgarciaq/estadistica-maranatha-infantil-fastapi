<DonacionCard@BoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: 15
    spacing: 8
    donacion_id: ''
    fecha: ''
    descripcion: ''
    cantidad: ''
    unidad: ''
    equipo: ''
    canvas.before:
        Color:
            rgba: 0.15, 0.25, 0.45, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [15,]
    
    BoxLayout:
        size_hint_y: None
        height: 30
        Label:
            text: "ID: " + root.donacion_id
            bold: True
            font_size: 18
            halign: 'left'
            text_size: self.size
        Label:
            text: root.fecha
            halign: 'right'
            text_size: self.size
            color: 0.8, 0.8, 0.8, 1

    Label:
        text: root.descripcion
        size_hint_y: None
        height: self.texture_size[1] + 10
        text_size: self.width, None
        halign: 'left'
        valign: 'middle'
        font_size: 20
        color: 1, 1, 1, 1

    BoxLayout:
        size_hint_y: None
        height: 30
        Label:
            text: "Cant: " + root.cantidad + " " + root.unidad
            halign: 'left'
            text_size: self.size
            color: 0.5, 0.9, 1, 1  # Cyan-ish blue
        Label:
            text: "Equipo: " + root.equipo
            halign: 'right'
            text_size: self.size
            color: 0.9, 0.9, 0.9, 1

<ListDonacionesScreen>:
    name: 'lista_donaciones'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Lista de Donaciones'
            font_size: 30
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 50
        ScrollView:
            BoxLayout:
                id: lista_donaciones
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: 10
                spacing: 15
        # Contenedor de botones
        BoxLayout:
            orientation: 'vertical'
            spacing: 10
            padding: 10
            size_hint_y: None
            height: self.minimum_height
            GridLayout:
                cols: 2
                spacing: 10
                padding: 10
                size_hint_y: None
                height: self.minimum_height
                Button: 
                    text: 'Listar'
                    font_size: 28
                    background_normal: ''
                    background_color: (0, 119/255, 194/255, 1)
                    size_hint: 1, None
                    height: 50
                    on_press: root.controlador.listar_donaciones(root)
                Button:
                    text: 'Cerrar'
                    font_size: 28
                    background_normal: ''
                    background_color: (0, 119/255, 194/255, 1)
                    size_hint: 1, None
                    height: 50
                    on_press: app.root.current = 'donaciones'