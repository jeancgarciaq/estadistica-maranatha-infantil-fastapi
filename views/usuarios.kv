#:import dp kivy.metrics.dp

<UserRow@BoxLayout>:
    id: row
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(36)
    spacing: dp(8)
    user_id: 0
    username: ''
    password: ''
    role: ''
    active: ''

    Button:
        text: root.username
        background_normal: ''
        background_color: (0.15, 0.2, 0.3, 1)
        on_press:
            app.root.get_screen('usuarios').seleccionar_usuario({'user_id': root.user_id, 'username': root.username, 'password': root.password, 'role': root.role, 'active': root.active})

    Label:
        text: root.password
        size_hint_x: 0.9

    Label:
        text: root.role
        size_hint_x: 0.8

    Label:
        text: root.active
        size_hint_x: 0.5


<UsuariosScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        Label:
            text: 'Gestion de Usuarios (solo root)'
            font_size: '22sp'
            size_hint_y: None
            height: dp(50)
            bold: True

        GridLayout:
            cols: 2
            size_hint_y: None
            height: dp(180)
            spacing: dp(8)

            Label:
                text: 'Usuario:'
                halign: 'right'
                text_size: self.size
            TextInput:
                id: user_username
                multiline: False

            Label:
                text: 'Contrasena:'
                halign: 'right'
                text_size: self.size
            TextInput:
                id: user_password
                multiline: False

            Label:
                text: 'Rol:'
                halign: 'right'
                text_size: self.size
            Spinner:
                id: user_role
                text: root.roles[0] if root.roles else ''
                values: root.roles

            Label:
                text: 'Activo:'
                halign: 'right'
                text_size: self.size
            CheckBox:
                id: user_active
                active: True
                disabled: root.selected_is_root

        BoxLayout:
            size_hint_y: None
            height: dp(42)
            spacing: dp(8)

            Button:
                text: 'Crear Usuario'
                background_normal: ''
                background_color: (0, 0.6, 0.3, 1)
                on_press: root.crear_usuario()

            Button:
                text: 'Actualizar Usuario'
                background_normal: ''
                background_color: (0, 0.47, 0.76, 1)
                on_press: root.actualizar_usuario()

            Button:
                text: 'Limpiar'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                on_press: root.limpiar_formulario()

        Label:
            text: 'Usuarios registrados (incluye contrasena en texto plano para reinicio en ambiente cerrado)'
            font_size: '14sp'
            size_hint_y: None
            height: dp(26)

        BoxLayout:
            size_hint_y: None
            height: dp(26)
            spacing: dp(8)
            Label:
                text: 'Usuario'
                bold: True
            Label:
                text: 'Contrasena'
                bold: True
                size_hint_x: 0.9
            Label:
                text: 'Rol'
                bold: True
                size_hint_x: 0.8
            Label:
                text: 'Activo'
                bold: True
                size_hint_x: 0.5

        RecycleView:
            id: users_rv
            viewclass: 'UserRow'
            data: []
            RecycleBoxLayout:
                default_size: None, dp(36)
                default_size_hint: 1, None
                size_hint_y: None
                height: self.minimum_height
                orientation: 'vertical'

        Button:
            text: 'Volver al Menu'
            size_hint_y: None
            height: dp(46)
            background_normal: ''
            background_color: (0.3, 0.3, 0.3, 1)
            on_press: root.volver_menu()
