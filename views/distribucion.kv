<DistribucionesScreen>:
    name: 'distribuciones'
    
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 1. TÍTULO
        Label:
            text: 'Distribución de Donaciones'
            font_size: '22sp'
            size_hint_y: None
            height: dp(60)
            bold: True

        # 2. ÁREA DE FORMULARIO (Con Scroll)
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(15)
                spacing: dp(15)

                # --- CAMPO: DONACIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80) # Un poco más alto para acomodar el botón al lado
                    Label:
                        text: 'Donación:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: donacion_id
                            hint_text: 'ID de Donación'
                            readonly: True
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: 'Seleccionar'
                            size_hint_x: None
                            width: dp(110)
                            font_size: '14sp'
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_popup_donacion()

                # --- CAMPO: PREPARADO ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Alimento preparado:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: alimento_preparado_id
                            hint_text: 'ID de alimento preparado'
                            readonly: True
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: 'Seleccionar'
                            size_hint_x: None
                            width: dp(110)
                            font_size: '14sp'
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_popup_preparado()

                # --- CAMPO: CANTIDAD ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Cantidad:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: donacion_cantidad
                        input_type: 'number'
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                # --- CAMPO: MEDIDA ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Medida:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    Spinner:
                        id: donacion_unidad
                        text: 'Unidad(es)'
                        values: root.medidas
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                # --- CAMPO: FECHA (Con Icono Unicode) ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Fecha:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: fecha
                            readonly: True
                            hint_text: 'YYYY-MM-DD'
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: '\uf133'  
                            font_name: 'LineAwesome'
                            font_size: '24sp'
                            size_hint_x: None
                            width: dp(50)
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_datepicker('fecha')

                # --- CAMPO: SALONES ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Salones:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: salon_id
                            hint_text: 'ID de Salón'
                            readonly: True
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: 'Seleccionar'
                            size_hint_x: None
                            width: dp(110)
                            font_size: '14sp'
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_popup_salon()

                # --- CAMPO: ÁREAS ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Áreas:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: area_id
                            hint_text: 'ID de Área'
                            readonly: True
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: 'Seleccionar'
                            size_hint_x: None
                            width: dp(110)
                            font_size: '14sp'
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_popup_area()

                # --- CAMPO: RECEPCIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Recepción:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: recepcion_id
                            hint_text: 'ID de Recepción'
                            readonly: True
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: 'Seleccionar'
                            size_hint_x: None
                            width: dp(110)
                            font_size: '14sp'
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_popup_recepcion()

        # 3. BOTONES DE ACCIÓN (Fijos abajo)
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(130)
            padding: dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.2
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Botón Guardar (Principal)
            Button:
                text: 'GUARDAR DISTRIBUCIÓN'
                font_size: '18sp'
                bold: True
                background_normal: ''
                background_color: (0, 0.47, 0.76, 1)
                size_hint_y: 0.5
                on_press: root.guardar_distribucion()

            # Botones Secundarios
            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_y: 0.5

                Button:
                    text: 'VER LISTA'
                    font_size: '16sp'
                    background_normal: ''
                    background_color: (0.2, 0.5, 0.2, 1)
                    on_press: app.root.current = 'lista_distribuciones'

                Button:
                    text: 'VOLVER AL MENU'
                    font_size: '16sp'
                    background_normal: ''
                    background_color: (0.5, 0.5, 0.5, 1)
                    on_press: app.root.current = 'menu'