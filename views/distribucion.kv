<DistribucionScreen>:
    name: 'distribucion'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Distribución de Maranatha Infantil'
            font_size: 30
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 50
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        # Formulario
        ScrollView:
            GridLayout:
                cols: 2
                size_hint_y: None
                height: self.minimum_height
                Label:
                    text: 'Donación:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 50
                Spinner:
                    id: donacion_spinner
                    text: 'Seleccionar Donación'
                    values: []
                Label:
                    text: 'Cantidad:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None 
                    height: 50
                TextInput:
                    id: donacion_cantidad
                    input_type: 'number'
                Label:
                    text: 'Unidad:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None 
                    height: 50
                TextInput:
                    id: donacion_unidad
                Label:
                    text: 'Salones:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 50
                GridLayout:
                    id: salones_seleccionados
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                Button:
                    text: 'Registrar Distribución'
                    font_size: 28
                    background_normal: ''
                    background_color: (0, 119/255, 194/255, 1)
                    size_hint_y: None
                    height: 50
                    on_press: root.controlador.registrar_distribucion(root.obtener_donacion_seleccionada(), root.obtener_salones_seleccionados())
                Button:
                    text: 'Listar Distribuciones'
                    font_size: 28
                    background_normal: ''
                    background_color: (0, 119/255, 194/255, 1)
                    size_hint_y: None
                    height: 50
                    on_press: root.mostrar_popup_lista()
        # Lista de distribuciones (opcional)
        ScrollView:
            GridLayout:
                id: lista_distribuciones
                cols: 2 # Donación, Salones
                size_hint_y: None
                height: self.minimum_height
        Button:
            text: 'Volver al Menú'
            font_size: 28
            background_normal: ''
            background_color: (0, 119/255, 194/255, 1)
            size_hint_y: None
            height: 50
            on_press: root.manager.current = 'menu'