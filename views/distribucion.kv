<DistribucionesScreen>:
    name: 'distribuciones'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Distribución de Donaciones'
            font_size: 36
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 50
        # Formulario
        ScrollView:
            GridLayout:
                cols: 2
                size_hint_y: None
                height: self.minimum_height
                padding: 20
                spacing: 20
                Label:
                    text: 'Donación:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 50
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 50
                    TextInput:
                        id: donacion_id
                        hint_text: 'ID de Donación'
                        readonly: True
                    Button:
                        text: 'Seleccionar'
                        size_hint_x: None
                        width: 120
                        on_press: root.abrir_popup_donacion()
                Label:
                    text: 'Cantidad:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None 
                    height: 50
                TextInput:
                    id: donacion_cantidad
                    input_type: 'number'
                Label:
                    text: 'Unidad:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None 
                    height: 50
                TextInput:
                    id: donacion_unidad
                Label:
                    text: 'Fecha:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None 
                    height: 50
                BoxLayout:
                    orientation: 'horizontal'
                    spacing: 10
                    TextInput:
                        id: fecha
                        readonly: True
                        hint_text: 'YYYY-MM-DD'
                    Button:
                        size_hint_x: None
                        width: 50
                        background_normal: ''
                        background_color: (0, 119/255, 194/255, 1)
                        on_press: root.abrir_datepicker('fecha')
                        Image:
                            source: 'images/calendar_icon.png'
                            center_x: self.parent.center_x
                            center_y: self.parent.center_y
                            size: 30, 30
                            allow_stretch: True
                Label:
                    text: 'Salones:'
                    font_size: 28
                    color: 1, 1, 1, 1
                    size_hint_y: None
                    height: 50
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: 50
                    TextInput:
                        id: salon_id
                        hint_text: 'ID de Salón'
                        readonly: True
                    Button:
                        text: 'Seleccionar'
                        size_hint_x: None
                        width: 120
                        on_press: root.abrir_popup_salon()
        # Botones de acción
        BoxLayout:
            size_hint_y: None
            height: 50
            spacing: 10
            padding: 10
            Button:
                text: 'Guardar'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: root.guardar_distribucion()
            Button:
                text: 'Ver Lista'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: app.root.current = 'lista_distribuciones'
            Button:
                text: 'Cancelar'
                font_size: 28
                background_normal: ''
                background_color: (0, 119/255, 194/255, 1)
                on_press: app.root.current = 'menu'