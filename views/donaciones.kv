<DonacionesScreen>:
    name: 'donaciones'
    
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 1. TÍTULO
        Label:
            text: 'Donaciones de Maranatha Infantil'
            font_size: '22sp'
            size_hint_y: None
            height: dp(60)
            bold: True

        # 2. ÁREA DE CONTENIDO (Con Scroll para que el teclado no estorbe)
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(15)
                spacing: dp(15)

                # --- CAMPO: ID DONACIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Id Donación:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: donacion_id
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                # --- CAMPO: DESCRIPCIÓN ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Descripción:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: donacion_descripcion
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                # --- CAMPO: CANTIDAD Y MEDIDA (En una fila para ahorrar espacio) ---
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(130)
                    spacing: dp(10)
                    
                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Cantidad:'
                            font_size: '16sp'
                            halign: 'left'
                            text_size: self.size
                        TextInput:
                            id: donacion_cantidad
                            multiline: False
                            input_type: 'number'
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                    BoxLayout:
                        orientation: 'vertical'
                        Label:
                            text: 'Medida:'
                            font_size: '16sp'
                            halign: 'left'
                            text_size: self.size
                        Spinner:
                            id: donacion_unidad
                            text: 'Unidad(es)'
                            values: root.medidas
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)

                # --- CAMPO: FECHA (Con Icono Unicode) ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Fecha:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: donacion_fecha
                            readonly: True
                            hint_text: 'YYYY-MM-DD'
                            multiline: False
                            font_size: '16sp'
                        Button:
                            text: '\uf133'
                            font_name: 'LineAwesome'
                            font_size: '24sp'
                            size_hint_x: None
                            width: dp(50)
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_datepicker('donacion_fecha')

                # --- CAMPO: EQUIPO ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Equipo:'
                        font_size: '16sp'
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: donacion_equipo
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

        # 3. BOTONES DE ACCIÓN (Fijos abajo)
        GridLayout:
            cols: 2
            size_hint_y: None
            height: dp(120)
            padding: dp(10)
            spacing: dp(10)

            Button:
                text: 'Crear'
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0, 0.6, 0.3, 1) # Verde
                on_press: root.crear_donacion()

            Button:
                text: 'Actualizar'
                font_size: '16sp'
                background_normal: ''
                background_color: (0, 0.47, 0.76, 1) # Azul
                on_press: root.actualizar_donacion()

            Button:
                text: 'Eliminar'
                font_size: '16sp'
                background_normal: ''
                background_color: (0.8, 0.2, 0.2, 1) # Rojo
                on_press: root.eliminar_donacion(donacion_id.text)

            Button:
                text: 'Buscar'
                font_size: '16sp'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1) # Gris
                on_press: 
                    root.buscar_donacion()
                    donacion_id.text = ''
                    donacion_descripcion.text = ''

            # Botón Listar (Ocupa las dos columnas de la fila inferior)
            Button:
                text: 'VER LISTA'
                size_hint_x: 2
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0.2, 0.5, 0.7, 1)
                on_press: app.root.current = 'lista_donaciones'

        # 4. BOTÓN VOLVER (Separado y claro)
        Button:
            text: 'Volver al Menú'
            size_hint_y: None
            height: dp(50)
            font_size: '18sp'
            background_normal: ''
            background_color: (0.3, 0.3, 0.3, 1)
            on_press: root.manager.current = 'menu'