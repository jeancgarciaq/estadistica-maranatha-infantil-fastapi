<RecepcionScreen>:
    name: 'recepciones'
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Label:
            text: 'Recepción de Maranatha Infantil'
            font_size: '24sp'
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(60)
            bold: True

        ScrollView:
            do_scroll_x: False
            do_scroll_y: True

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: dp(20)
                spacing: dp(15)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'Nombre:'
                        font_size: '18sp'
                        color: 1, 1, 1, 1
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: recepcion_nombre
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(80)
                    Label:
                        text: 'Fecha:'
                        font_size: '18sp'
                        color: 1, 1, 1, 1
                        halign: 'left'
                        text_size: self.size
                    BoxLayout:
                        orientation: 'horizontal'
                        spacing: dp(10)
                        TextInput:
                            id: recepcion_fecha
                            readonly: True
                            hint_text: 'YYYY-MM-DD'
                            multiline: False
                            font_size: '18sp'
                            size_hint_y: None
                            height: dp(40)
                        Button:
                            size_hint_x: None
                            width: dp(50)
                            background_normal: ''
                            background_color: (0, 0.47, 0.76, 1)
                            on_press: root.abrir_datepicker('recepcion_fecha')
                            Image:
                                source: 'images/calendar_icon.png'
                                center_x: self.parent.center_x
                                center_y: self.parent.center_y
                                size: dp(30), dp(30)

                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: dp(70)
                    Label:
                        text: 'ID Recepción:'
                        font_size: '18sp'
                        color: 1, 1, 1, 1
                        halign: 'left'
                        text_size: self.size
                    TextInput:
                        id: recepcion_id
                        multiline: False
                        font_size: '18sp'
                        size_hint_y: None
                        height: dp(40)

                GridLayout:
                    cols: 2
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(120)

                    Button:
                        text: 'Crear'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press: root.crear_recepcion()

                    Button:
                        text: 'Actualizar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0, 0.47, 0.76, 1)
                        on_press: root.actualizar_recepcion()

                    Button:
                        text: 'Eliminar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0.8, 0.2, 0.2, 1)
                        on_press: root.eliminar_recepcion(recepcion_id.text)

                    Button:
                        text: 'Listar'
                        font_size: '18sp'
                        background_normal: ''
                        background_color: (0.2, 0.6, 0.2, 1)
                        on_press: root.cargar_recepciones()

                Label:
                    text: 'Recepciones registradas'
                    font_size: '20sp'
                    size_hint_y: None
                    height: dp(40)
                    color: 1, 1, 1, 1

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True
                    size_hint_y: None
                    height: dp(260)

                    GridLayout:
                        id: lista_recepciones
                        cols: 1
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(10)

        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(110)
            padding: dp(10)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.2
                Rectangle:
                    pos: self.pos
                    size: self.size

            Button:
                text: 'Volver al Menú'
                font_size: '18sp'
                background_normal: ''
                background_color: (0.5, 0.5, 0.5, 1)
                size_hint_y: 1
                on_press: root.manager.current = 'menu'


<RecepcionCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(130)
    padding: dp(10)
    spacing: dp(6)

    canvas.before:
        Color:
            rgba: 0.2, 0.2, 0.2, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10)]

    Label:
        text: '[b]' + root.nombre + '[/b]'
        markup: True
        font_size: '16sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: dp(30)

    Label:
        text: 'ID: ' + str(root.recepcion_id) + ' | Fecha: ' + root.fecha
        font_size: '14sp'
        halign: 'left'
        valign: 'middle'
        text_size: self.size
        size_hint_y: None
        height: dp(36)

    BoxLayout:
        size_hint_y: None
        height: dp(38)
        spacing: dp(8)

        Button:
            text: 'Editar'
            font_size: '13sp'
            background_normal: ''
            background_color: (0, 0.5, 1, 1)
            on_press: root.editar_callback(root.recepcion_id) if root.editar_callback else None

        Button:
            text: 'Eliminar'
            font_size: '13sp'
            background_normal: ''
            background_color: (1, 0.2, 0.2, 1)
            on_press: root.eliminar_callback(root.recepcion_id) if root.eliminar_callback else None
