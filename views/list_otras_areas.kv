<AreaCard@BoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    padding: dp(15)
    spacing: dp(8)

    area_id: ''
    area_nombre: ''
    fecha: ''
    alabanza: ''
    protocolo: ''
    semillitas: ''
    sonido: ''
    teatro: ''
    tv: ''
    ujier: ''
    seguridad: ''

    canvas.before:
        Color:
            rgba: 0.15, 0.25, 0.45, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12),]

    BoxLayout:
        size_hint_y: None
        height: dp(30)
        Label:
            text: root.area_nombre
            bold: True
            font_size: '18sp'
            halign: 'left'
            text_size: self.size
        Label:
            text: root.fecha
            font_size: '14sp'
            halign: 'right'
            text_size: self.size
            color: 0.7, 0.7, 0.7, 1

    Label:
        text: 'ID: ' + root.area_id
        font_size: '14sp'
        halign: 'left'
        text_size: self.size
        color: 0.6, 0.6, 0.6, 1

    GridLayout:
        cols: 2
        size_hint_y: None
        height: self.minimum_height
        row_default_height: dp(28)
        row_force_default: True
        spacing: dp(6)

        Label:
            text: 'Alabanza: ' + root.alabanza
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Protocolo: ' + root.protocolo
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Semillitas: ' + root.semillitas
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Sonido: ' + root.sonido
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Teatro: ' + root.teatro
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'TV: ' + root.tv
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Ujier: ' + root.ujier
            halign: 'left'
            text_size: self.size
            font_size: '14sp'
        Label:
            text: 'Seguridad: ' + root.seguridad
            halign: 'left'
            text_size: self.size
            font_size: '14sp'

    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(10)
        Button:
            text: 'Editar'
            font_size: '14sp'
            background_normal: ''
            background_color: (0, 0.47, 0.76, 1)
            on_press: app.root.get_screen('lista_otras_areas').editar_registro(root.area_id)
        Button:
            text: 'Eliminar'
            font_size: '14sp'
            background_normal: ''
            background_color: (0.8, 0, 0, 1)
            on_press: app.root.get_screen('lista_otras_areas').confirmar_eliminacion(root.area_id)

<ListOtrasAreasScreen>:
    name: 'lista_otras_areas'
    
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.102, 0.2, 0.396, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 1. TÍTULO (Fijo arriba)
        Label:
            text: 'Listado de Otras Áreas'
            font_size: '22sp'
            size_hint_y: None
            height: dp(60)
            bold: True

        # 2. FILTRO POR FECHA
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10), 0, dp(10), dp(10)
            spacing: dp(10)

            TextInput:
                id: fecha_filtro
                text: root.fecha_filtro
                readonly: True
                hint_text: 'Seleccione fecha (YYYY-MM-DD)'
                multiline: False
                font_size: '16sp'

            Button:
                text: 'FECHA'
                size_hint_x: None
                width: dp(110)
                font_size: '14sp'
                bold: True
                background_normal: ''
                background_color: (0.2, 0.6, 0.2, 1)
                on_press: root.abrir_datepicker_filtro()

        # 3. ÁREA DE LA LISTA (ScrollView)
        ScrollView:
            do_scroll_x: False
            do_scroll_y: True
            
            GridLayout:
                id: container
                cols: 1  
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(12)
                padding: dp(15)

        # 4. FOOTER DE BOTONES (Fijo abajo)
        GridLayout:
            cols: 2
            size_hint_y: None
            height: dp(120)
            padding: dp(10)
            spacing: dp(10)

            Button:
                text: 'LISTAR'
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0, 0.6, 0.2, 1) # Verde
                on_press: root.cargar_datos()

            Button:
                text: 'CERRAR'
                font_size: '16sp'
                bold: True
                background_normal: ''
                background_color: (0.7, 0.1, 0.1, 1) # Rojo
                on_press: app.root.current = 'otrasareas'