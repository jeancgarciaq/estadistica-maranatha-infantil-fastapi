# Variables de Entorno para la aplicación EMI Web

# Configuración de la Base de Datos
# Para SQLite local (desarrollo), puedes comentar la línea de DATABASE_URL
# y la aplicación usará "sqlite:///./models/app.db" por defecto.
# Para PostgreSQL en Google Cloud SQL, usa el formato de socket de Unix para Cloud Run.
# Reemplaza [USER], [PASSWORD], [DB_NAME], [PROJECT_ID], [REGION] con tus datos reales.
DATABASE_URL="postgresql+psycopg2://[USER]:[PASSWORD]@/[DB_NAME]?host=/cloudsql/[PROJECT_ID]:[REGION]:emk-db"

# Otras variables de entorno (si las necesitas, por ejemplo, para envío de correos)
# SMTP_SERVER="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USERNAME="tu_correo@example.com"
# SMTP_PASSWORD="tu_password_app"