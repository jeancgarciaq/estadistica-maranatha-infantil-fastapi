# Copia este archivo como variables de entorno en tu sistema.
# No subir secretos reales al repositorio.

FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com

# Opcional para script de sincronizacion inicial (si no usas FIREBASE_AUTH_TOKEN)
FIREBASE_BOOTSTRAP_EMAIL=admin@example.com
FIREBASE_BOOTSTRAP_PASSWORD=YOUR_PASSWORD

# Opcional: si en el login escriben usuario sin @dominio.
FIREBASE_AUTH_EMAIL_DOMAIN=example.com
