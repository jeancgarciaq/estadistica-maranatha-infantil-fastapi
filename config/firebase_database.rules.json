{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "user_roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "false"
      }
    },

    "collections": {
      "donaciones": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'distribuidor')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'distribuidor')"
      },
      "distribuciones": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'distribuidor')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'distribuidor')"
      },
      "aulas": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'maestro' || root.child('user_roles').child(auth.uid).child('role').val() === 'distribuidor')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'maestro')"
      },
      "salones": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador' || root.child('user_roles').child(auth.uid).child('role').val() === 'maestro')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador')"
      },
      "$other": {
        ".read": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador')",
        ".write": "auth != null && root.child('user_roles').child(auth.uid).child('active').val() === true && (root.child('user_roles').child(auth.uid).child('role').val() === 'root' || root.child('user_roles').child(auth.uid).child('role').val() === 'administrador')"
      }
    }
  }
}
